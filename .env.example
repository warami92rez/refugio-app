DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/refugio_app
# development = clave de ejemplo permitida y cookies sin https_only (solo en tu computadora).
# En produccion NO definas ENV: el modo estricto es el predeterminado.
ENV=development
# En produccion es obligatoria (minimo 32 caracteres). Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Primer admin. Solo actuan si todavia no existe ningun admin con contrasena.
# Despues de entrar por primera vez puedes (y conviene) borrar estas variables.
#   BOOTSTRAP_ADMIN_USERNAME=william
#   BOOTSTRAP_ADMIN_PASSWORD=una-clave-larga-de-al-menos-8
#   BOOTSTRAP_ADMIN_NOMBRE=William
# Alternativa manual: python -m app.cli crear-admin --username william
