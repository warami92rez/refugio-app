DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/refugio_app
# development = clave de ejemplo permitida y cookies sin https_only (solo en tu computadora).
# En produccion NO definas ENV: el modo estricto es el predeterminado.
ENV=development
# En produccion es obligatoria (minimo 32 caracteres). Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Nombres (separados por coma) que se promueven a admin automaticamente al iniciar sesion
ADMIN_NAMES=William
